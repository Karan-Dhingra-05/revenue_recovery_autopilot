# ─────────────────────────────────────────────────────────────────────────────
# Revenue Recovery Autopilot — Environment Variables
# Copy this file to backend/.env and fill in real values.
# NEVER commit the actual .env file.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/revenue_recovery

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Razorpay Test Mode (Phase 2 — leave blank for now) ───────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── LLM (Phase 4 — leave blank for now) ──────────────────────────────────────
LLM_API_KEY=

# ── Frontend (Next.js public env) ────────────────────────────────────────────
# Set this in frontend/.env.local (not here)
# NEXT_PUBLIC_API_URL=http://localhost:8000
